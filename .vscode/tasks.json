{
  "tasks": [
    {
      "type": "shell",
      "label": "ST-LINKv2 flash",
      "command": "st-flash",
      "args": [
        "write",
        "build/app/gd32_openfirmwaremower.bin",
        "0x08000000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
